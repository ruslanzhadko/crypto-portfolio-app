FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci
RUN npm prune --omit=dev --ignore-scripts
COPY tsconfig.json ./
COPY lib ./lib
COPY scripts/exchange-worker.ts ./scripts/exchange-worker.ts
COPY scripts/exchange-worker-health.mjs ./scripts/exchange-worker-health.mjs
USER node
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 CMD ["node", "scripts/exchange-worker-health.mjs"]
CMD ["node", "--import", "tsx", "scripts/exchange-worker.ts"]
