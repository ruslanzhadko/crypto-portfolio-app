generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// ERD artifact: prisma/erd.svg. Diagram generators are intentionally excluded
// from application dependencies; regenerate with separately installed tooling.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")  
  directUrl = env("DIRECT_URL")   
}
// ═══════════════════════════════════════
// КОРИСТУВАЧІ
// ═══════════════════════════════════════

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  passwordHash   String?
  role           Role      @default(USER)
  isBlocked      Boolean   @default(false)
  telegramChatId String?
  telegramUserId String?   @unique
  telegramBotAccess Boolean @default(false)
  telegramNotificationsEnabled Boolean @default(true)
  sessionVersion Int @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  wallets       Wallet[]
  triggers      PriceTrigger[]
  notifications NotificationLog[]
  accounts      Account[]
  sessions      Session[]
  snapshots     PortfolioSnapshot[]
  exchangeConnections ExchangeConnection[]
  capitalSnapshots PortfolioCapitalSnapshot[]
  capitalEvents CapitalEvent[]

  @@index([email])
}

enum Role {
  USER
  ADMIN
}

// Shared across serverless instances; keys are hashes, never emails or IPs.
model AuthRateLimit {
  key String @id
  attempts Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ═══════════════════════════════════════
// ГАМАНЦІ
// ═══════════════════════════════════════

model Wallet {
  id         String    @id @default(cuid())
  userId     String
  address    String
  network    Network   // EVM = одна адреса для всіх 9 EVM-мереж; SOLANA = окремо
  label      String?
  isActive   Boolean   @default(true)
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balances     TokenBalance[]
  transactions WalletTransaction[]
  exchangeConnections ExchangeConnection[]

  @@unique([userId, address, network])
  @@index([userId])
}

// EVM — одна адреса покриває всі EVM-мережі (Ethereum, BNB Chain, Polygon, Arbitrum, Optimism, Base, Avalanche, X Layer, Robinhood)
// SOLANA — окремо
enum Network {
  EVM
  SOLANA
}

// ═══════════════════════════════════════
// БАЛАНСИ ТОКЕНІВ
// ═══════════════════════════════════════

model TokenBalance {
  id           String   @id @default(cuid())
  walletId     String
  tokenSymbol  String
  tokenName    String
  // chainName — конкретна блокчейн-мережа: "ethereum","bsc","polygon","arbitrum","optimism","base","avalanche","xlayer","solana"
  chainName    String   @default("")
  tokenAddress String   @default("") // "" для нативних токенів
  decimals     Int      @default(18)
  balance      Float
  usdValue     Float    @default(0)
  priceUsd     Float    @default(0) // ціна за одиницю токена (USD)
  priceChange24h Float  @default(0) // % зміна за 24 год
  logoUrl      String?
  coingeckoId  String?
  isSpam       Boolean  @default(false)
  isHidden     Boolean  @default(false) // приховано вручну користувачем
  updatedAt    DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, chainName, tokenAddress, tokenSymbol])
  @@index([walletId])
}

// ═══════════════════════════════════════
// ТРАНЗАКЦІЇ
// ═══════════════════════════════════════

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  hash        String
  chainName   String   @default("")
  type        String
  tokenSymbol String?
  tokenName   String?
  fromAddress String?
  toAddress   String?
  value       Float?
  usdValue    Float?
  gasUsed     Float?
  status      String   @default("success")
  blockNumber BigInt?
  timestamp   DateTime
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, chainName, hash])
  @@index([walletId, timestamp])
}

// ═══════════════════════════════════════
// РИНКОВІ ЦІНИ (КЕШ)
// ═══════════════════════════════════════

model TokenPrice {
  id             String   @id @default(cuid())
  tokenId        String
  symbol         String
  name           String
  currentPrice   Float
  priceChange24h Float    @default(0)
  priceChange7d  Float    @default(0)
  marketCap      Float?
  volume24h      Float?
  logoUrl        String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([tokenId])
  @@index([symbol])
}

model PriceHistory {
  id        String   @id @default(cuid())
  tokenId   String
  price     Float
  timestamp DateTime
  createdAt DateTime @default(now())

  @@index([tokenId, timestamp])
}

// ═══════════════════════════════════════
// ЦІНОВІ ТРИГЕРИ
// ═══════════════════════════════════════

model PriceTrigger {
  id            String           @id @default(cuid())
  userId        String
  tokenId       String
  tokenSymbol   String
  tokenName     String
  triggerType   TriggerType      @default(PERCENT)
  threshold     Float            @default(0)
  targetPrice   Float?
  direction     TriggerDirection @default(BOTH)
  interval      Int              @default(60)
  isActive      Boolean          @default(true)
  lastCheckedAt DateTime?
  lastPrice     Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications NotificationLog[]

  @@index([userId])
  @@index([isActive])
}

enum TriggerDirection {
  UP
  DOWN
  BOTH
}

enum TriggerType {
  PERCENT      // спрацьовує коли зміна ціни за інтервал >= поріг %
  PRICE_TARGET // спрацьовує коли ціна перетинає задану позначку (одноразово)
}

// ═══════════════════════════════════════
// ЖУРНАЛ СПОВІЩЕНЬ
// ═══════════════════════════════════════

model NotificationLog {
  id           String   @id @default(cuid())
  userId       String
  triggerId    String?
  tokenSymbol  String
  message      String
  deltaPercent Float
  price        Float
  status       String   @default("sent")
  sentAt       DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trigger PriceTrigger? @relation(fields: [triggerId], references: [id])

  @@index([userId])
  @@index([triggerId])
}

// ═══════════════════════════════════════
// SNAPSHOT ВАРТОСТІ ПОРТФЕЛЯ
// ═══════════════════════════════════════

model PortfolioSnapshot {
  id        String   @id @default(cuid())
  userId    String
  totalUsd  Float
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
}

// ═══════════════════════════════════════
// КРИПТОЛЕНТА ИЗ TELEGRAM
// ═══════════════════════════════════════

model TelegramFeedSource {
  id            String   @id @default(cuid())
  username      String   @unique
  telegramId    String?
  title         String
  description   String?
  avatarUrl     String?
  isActive      Boolean  @default(true)
  lastMessageId Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posts TelegramFeedPost[]

  @@index([isActive])
}

model TelegramFeedPost {
  id                String       @id @default(cuid())
  sourceId          String
  telegramMessageId Int
  type              FeedPostType @default(OTHER)
  text              String       @db.Text
  title             String?
  symbol            String?
  direction         String?
  exchange          String?
  changePercent     Float?
  intervalSeconds   Int?
  amountUsd         Float?
  priceUsd          Float?
  limitUsd          Float?
  mediaUrl          String?
  telegramUrl       String
  metadata          Json?
  publishedAt       DateTime
  editedAt          DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  source TelegramFeedSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  media  TelegramFeedMedia?

  @@unique([sourceId, telegramMessageId])
  @@index([publishedAt])
  @@index([type, publishedAt])
  @@index([symbol, publishedAt])
}

model TelegramFeedMedia {
  postId    String   @id
  data      Bytes
  mimeType  String
  byteSize  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post TelegramFeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

enum FeedPostType {
  NEWS
  LISTING
  ARBITRAGE
  PRICE_ANOMALY
  LIQUIDATION
  TRADE_IDEA
  AIRDROP
  ANALYSIS
  OTHER
}

// Exchange monitoring: independent of OAuth Account and on-chain Wallet balances.
model ExchangeConnection {
  id String @id @default(cuid())
  userId String
  exchange String
  label String
  credentials String? @db.Text
  keyMask String?
  keyFingerprint String?
  credentialVersion Int @default(1)
  status String @default("PENDING")
  errorCode String?
  externalAccountId String?
  walletId String?
  hyperCoreMigratedAt DateTime?
  balancesAt DateTime?
  positionsAt DateTime?
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)
  accounts ExchangeAccount[]
  job ExchangeSyncJob?
  runs ExchangeSyncRun[]
  @@unique([userId, exchange, keyFingerprint])
  @@unique([userId, exchange, externalAccountId])
  @@unique([walletId, exchange])
  @@index([userId, status])
}

model ExchangeAccount {
  id String @id @default(cuid())
  connectionId String
  accountKey String
  kind String
  mode String
  equityUsd Decimal? @db.Decimal(38, 18)
  availableUsd Decimal? @db.Decimal(38, 18)
  unrealizedPnlUsd Decimal? @db.Decimal(38, 18)
  complete Boolean @default(false)
  errorCode String?
  balancesAt DateTime?
  positionsAt DateTime?
  connection ExchangeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  balances ExchangeBalance[]
  positions ExchangePosition[]
  @@unique([connectionId, accountKey])
}

model ExchangeBalance {
  id String @id @default(cuid())
  accountId String
  assetId String
  symbol String
  total Decimal @db.Decimal(38, 18)
  free Decimal? @db.Decimal(38, 18)
  locked Decimal? @db.Decimal(38, 18)
  debt Decimal? @db.Decimal(38, 18)
  usdValue Decimal? @db.Decimal(38, 18)
  priceUsd Decimal? @db.Decimal(38, 18)
  account ExchangeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, assetId])
}

model ExchangePosition {
  funding Json?
  id String @id @default(cuid())
  accountId String
  positionKey String
  symbol String
  base String
  settle String
  side String
  contracts Decimal @db.Decimal(38, 18)
  contractSize Decimal @db.Decimal(38, 18)
  baseSize Decimal @db.Decimal(38, 18)
  notionalUsd Decimal? @db.Decimal(38, 18)
  entryPrice Decimal? @db.Decimal(38, 18)
  markPrice Decimal? @db.Decimal(38, 18)
  liquidationPrice Decimal? @db.Decimal(38, 18)
  leverage Decimal? @db.Decimal(38, 18)
  marginMode String?
  margin Decimal? @db.Decimal(38, 18)
  unrealizedPnl Decimal? @db.Decimal(38, 18)
  unrealizedPnlUsd Decimal? @db.Decimal(38, 18)
  updatedAt DateTime
  account ExchangeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, positionKey])
  @@index([base, side])
}

// One durable slot per connection: manual requests coalesce with scheduled work.
model ExchangeSyncJob {
  connectionId String @id
  dueAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  attempts Int @default(0)
  forceBalances Boolean @default(true)
  connection ExchangeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@index([dueAt, leaseUntil])
}

model ExchangeSyncRun {
  id String @id @default(cuid())
  connectionId String
  status String
  errorCode String?
  durationMs Int
  createdAt DateTime @default(now())
  connection ExchangeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@index([connectionId, createdAt])
}

// Shared request budget and worker leadership, without Redis.
model ExchangeWorkerLease {
  name String @id
  owner String
  expiresAt DateTime
  heartbeatAt DateTime @default(now())
}

model PortfolioCapitalSnapshot {
  id String @id @default(cuid())
  userId String
  bucket DateTime
  totalUsd Decimal @db.Decimal(38, 18)
  walletsUsd Decimal @db.Decimal(38, 18)
  exchangesUsd Decimal @db.Decimal(38, 18)
  sourceSet String
  complete Boolean
  sources Json
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, bucket])
}

model CapitalEvent {
  id String @id @default(cuid())
  userId String
  sourceId String
  kind String
  label String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
